# Supabase Dashboard > Connect. This is a PUBLIC publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Local origin. On Vercel production, set this to https://duopet-pi.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fixtures are never used unless this is explicitly set to demo.
DUOPET_DATA_MODE=production
